# ============================================================
# MisiPulsa — Sembunyikan ekstensi .html (Apache / cPanel)
# Pengunjung tidak akan melihat/mengakses format .html:
#   /dashboard       -> dashboard.html  (URL tetap tanpa .html)
#   /dashboard.html  -> 301 redirect ke /dashboard
# ============================================================
Options -MultiViews
RewriteEngine On

# 1) Redirect URL ber-ekstensi .html ke versi tanpa ekstensi (301)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# 2) Sajikan xxx.html saat /xxx diminta (tanpa mengubah URL)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# 3) Halaman utama
DirectoryIndex index.html
